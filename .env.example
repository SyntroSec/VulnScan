# Credentialed SSH audit (never commit real secrets)
SSH_HOST=192.168.1.10
SSH_PORT=22
SSH_USERNAME=auditor
SSH_PASSWORD=
SSH_PRIVATE_KEY_PATH=
SSH_PRIVATE_KEY_PASSPHRASE=

# Optional: override default paths
CVE_RULES_PATH=rules/cve_database.json
PLUGIN_SIGNATURES_PATH=plugins/signatures.yaml
REPORT_OUTPUT_DIR=reports
